PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gestion_comm

# 32 caractères minimum. Générer avec :
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# Adresse exacte d'où l'application web est ouverte dans le navigateur.
#  - développement avec Vite :          http://localhost:5173
#  - frontend servi par NestJS (local) : http://localhost:3000
#  - production :                        https://boutique.exemple.com
CORS_ORIGIN=http://localhost:5173

# Production derrière Nginx : 1. En local : 0.
TRUST_PROXY=0

# Frontend compilé servi par NestJS sur le même port que l'API.
# Vide = API seule (développement avec Vite). Ex. : ../client/dist
CLIENT_DIST=

ADMIN_NAME=Administrateur
ADMIN_PHONE=620000000
ADMIN_PASSWORD=
